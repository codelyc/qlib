# ═══════════════════════════════════════════════════════════════
# fin-factor 环境配置  .env
# ═══════════════════════════════════════════════════════════════
#
# 🎯 这是所有脚本的【唯一配置中心】
#    脚本通过 source .env 自动加载，qrun 从环境变量读取模板参数
#    修改此文件后无需改任何脚本
#
# ⚠️  本文件含本机路径，已加入 .gitignore，不会提交 git
#     需要分享给他人请参考 .env.template
#
# ℹ️  所有变量都使用 export，这样 source .env 后子进程（如 qrun）
#    也能通过 os.environ 读取到这些变量
# ═══════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════
# 基础设施配置（大写，UNIX 惯例）
# ══════════════════════════════════════════════════════════════

# ── 项目根目录（必填）────────────────────────────────────────
export PROJECT_ROOT=/home/lixiang/code/big/ai-qlib

# ── 派生路径 ─────────────────────────────────────────────────
export SKILL_DIR=$PROJECT_ROOT/.github/skills/fin-factor
export FACTOR_WORKSPACE_DIR=$PROJECT_ROOT/factor_workspace
export EXP_ROOT=$FACTOR_WORKSPACE_DIR/market_trend_factor

# ── 本地 Python 环境 ─────────────────────────────────────────
export PYTHON_BIN=/home/lixiang/miniconda3/envs/rdagent4qlib/bin/python

# ── Docker 配置 ───────────────────────────────────────────────
export DOCKER_IMAGE=local_qlib:latest
export DOCKER_SHM_SIZE=16g
# export DOCKER_CPUS=16        # 可选：限制 CPU 核数
# export DOCKER_MEMORY=32g     # 可选：限制内存上限

# ── 数据目录 ──────────────────────────────────────────────────
export QLIB_DATA_DIR=$PROJECT_ROOT/qlib/data
export QLIB_DOWNLOAD_DIR=$PROJECT_ROOT/qlib/downloads

# ── 数据生成参数（gen_daily_pv.py）───────────────────────────
export DATA_START_DATE=2020-01-01
export DEBUG_START_DATE=2020-01-01
export DEBUG_END_DATE=2021-12-31

# ── MLflow 实验跟踪 ───────────────────────────────────────────
export MLFLOW_TRACKING_URI=file://${PROJECT_ROOT}/mlruns

# ══════════════════════════════════════════════════════════════
# Qlib 基础特征配置（完全对齐 RD-Agent）
# ══════════════════════════════════════════════════════════════
# 选择要使用的基础因子集合（可选：ALPHA20, ALPHA158）
# common.sh 会自动调用 default_features.py 将其解析为特征列表
# 默认使用 ALPHA20 进行搜索，以避免 AI 因子被 158 个经典因子淹没
export ACTIVE_FEATURE_SET=ALPHA20

# ══════════════════════════════════════════════════════════════
# 回测参数（小写，与 YAML 模板 {{ 变量名 }} 一一对应）
# ──────────────────────────────────────────────────────────────
# qrun 原生从 os.environ 读取这些变量填充 Jinja2 模板。
# 如果某个变量未设置，YAML 模板中的 default() 值会生效。
# 临时覆盖：export topk=30 && qrun conf_combined_factors.yaml
# ══════════════════════════════════════════════════════════════

# ── Qlib 数据路径 ────────────────────────────────────────────
# 本地运行时指向宿主机数据目录；Docker 内由脚本覆盖为 /qlib_data
export QLIB_PROVIDER_URI=$QLIB_DATA_DIR

# ── 市场 & 基准 ───────────────────────────────────────────────
export market=csi300
export benchmark=SH000300

# ── 日期区间 ──────────────────────────────────────────────────
export train_start=2020-01-01
export train_end=2022-12-31
export valid_start=2023-01-01
export valid_end=2024-12-31
export test_start=2025-01-01
export test_end=null

# ── 归一化拟合区间 ────────────────────────────────────────────
export fit_start_time=2020-01-01
export fit_end_time=2022-12-31

# ── LightGBM 模型参数 ────────────────────────────────────────
export learning_rate=0.2
export max_depth=8
export num_leaves=210
export num_threads=20
export colsample_bytree=0.8879
export subsample=0.8789
export lambda_l1=205.6999
export lambda_l2=580.9768

# ── 策略参数 ──────────────────────────────────────────────────
export topk=50
export n_drop=5
export account=100000000
export open_cost=0.0005
export close_cost=0.0015

# ══════════════════════════════════════════════════════════════
# fin-model AI 模型优化配置
# ══════════════════════════════════════════════════════════════
# 参考: RD-Agent/rdagent/app/qlib_rd_loop/conf.py ModelBasePropSetting

# ── 派生路径 ─────────────────────────────────────────────────
export MODEL_SKILL_DIR=$PROJECT_ROOT/.github/skills/fin-model
export MODEL_EXP_ROOT=$FACTOR_WORKSPACE_DIR/model_optimization

# ── PyTorch 训练超参（对齐 RD-Agent 默认值）─────────────────
# 这些变量名与 YAML 模板 {{ var }} 一一对应，qrun 从 env 读取
export n_epochs=100
export lr=0.0002
export early_stop=10
export batch_size=256
export weight_decay=0.0001

# ── 数据集配置 ────────────────────────────────────────────────
export dataset_cls=TSDatasetH          # TSDatasetH=时序模型, DatasetH=表格模型
export step_len=20                      # 时序窗口长度
export num_timesteps=20                 # 与 step_len 一致
export num_features=20                  # Alpha20=20, ALPHA158=158（自动由脚本计算）

# ── Docker 执行参数 ────────────────────────────────────────────
export DOCKER_MOUNT_PATH=/workspace/qlib_workspace/
export DOCKER_MAX_RETRIES=3
export DOCKER_RETRY_WAIT=10

# ══════════════════════════════════════════════════════════════
# fin-quant 联合因子+模型优化配置
# ══════════════════════════════════════════════════════════════
# 参考: RD-Agent/rdagent/app/qlib_rd_loop/quant.py QuantRDLoop
# fin-quant 调用 fin-factor 和 fin-model 的脚本，自身只做编排

# ── 派生路径 ─────────────────────────────────────────────────
export QUANT_SKILL_DIR=$PROJECT_ROOT/.github/skills/fin-quant
export QUANT_EXP_ROOT=$FACTOR_WORKSPACE_DIR/quant_optimization
